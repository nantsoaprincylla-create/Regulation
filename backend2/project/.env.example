# --- Django ---
DJANGO_SETTINGS_MODULE=project.settings.dev
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
DB_NAME=telecom_regulation
DB_USER=telecom_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Fichiers ---
PRIVATE_MEDIA_ROOT=./private_media
MAX_UPLOAD_SIZE_MB=20

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12

# --- Sondages ---
SURVEY_OPERATOR_APPROVAL_REQUIRED=true
SURVEY_PUBLIC_MIN_RESPONDENTS=5
SURVEY_FINGERPRINT_SALT=change-me-too

# --- Scraping (liste vide = scraping désactivé) ---
SCRAPING_ALLOWED_DOMAINS=
SCRAPING_USER_AGENT=ARTEC-QoS-Collector/1.0

# --- Machine learning ---
ML_MIN_TRAINING_ROWS=300
ML_MIN_ROWS_PER_CLASS=30
ML_MIN_GROUPS=5

# --- Comptes initiaux (facultatif) ---
# INITIAL_ACCOUNTS_PASSWORD=
# INITIAL_ACCOUNTS_DOMAIN=plateforme.local
